# exclude all dot files except .git, appveyor and travis files
.*
!.git*
!.appveyor*
!.editorconfig
!.vscode
!.github/
!.github/**

# exclude binaries and temporary files
[Bb]in/
[Bb]uild*/
# LuaJIT's host build tool is source, not output.
!Externals/LuaJIT-proj/HostBuildTools/buildvm/
local.properties

# Local game data provided for testing (proprietary; never commit)
gamefiles/

# User-specific files
*.user
*.user.props
*.nvuser
*.PVS-Studio.*

# Visual Studio profiler
*.psess
*.vsp
*.vspx

# exclude doxygen output
doc/doxygen/html/*
